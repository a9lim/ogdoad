fb=freefactor(tw,Sg,SA,Sy,sm,11,2,18,20,990,495,[991],1);
print("unpinned (F_s' embedding twisted by Frobenius^1): minpoly==V1: ",vector(#fb,i,lift(fb[i][2])==V1));
